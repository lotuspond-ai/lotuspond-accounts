{
  "name": "lotuspond-accounts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LotusPond Accounts: the one LotusPond account for Health and Works, at accounts.lotuspond.ai.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node tools/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "test:e2e": "tools/e2e.sh",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate --config drizzle.directory.config.ts && drizzle-kit generate --config drizzle.cell.config.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1170.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/platypi": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
