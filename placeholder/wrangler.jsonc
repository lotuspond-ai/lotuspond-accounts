// The placeholder at accounts.lotuspond.ai until LotusPond Accounts is deployed (placeholder/README.md).
// One small Worker with the page, stylesheet and fonts bundled in: no storage, no secrets. Every path shows the page.
// Run `npm run placeholder:build` first: it writes public/assets/.
{
  "name": "lotuspond-accounts-placeholder",
  "account_id": "a9415202683c1d7629eef5f39330aa75",
  "main": "worker.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.txt", "**/*.css"], "fallthrough": false },
    { "type": "Data", "globs": ["**/*.woff2"], "fallthrough": false }
  ],
  "routes": [{ "pattern": "accounts.lotuspond.ai", "custom_domain": true }],
  "observability": { "enabled": false }
}
