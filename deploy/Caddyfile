# HTTPS for LotusPond Accounts. Hydra answers the OpenID Connect endpoints; the Accounts app answers everything else.
# Hydra's admin API is not reachable from here (docker-compose.yml, networks.admin).
{
	email {$ACME_EMAIL}
}

(routes) {
	@hydra path /oauth2/* /userinfo /.well-known/openid-configuration /.well-known/jwks.json
	handle @hydra {
		reverse_proxy hydra:4444
	}
	handle {
		reverse_proxy app:8790
	}
	header -Server
}

{$DOMAIN} {
	encode zstd gzip
	import routes
}
